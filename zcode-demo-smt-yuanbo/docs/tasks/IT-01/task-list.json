  "e2e-paths": [
    {
      "id": "PATH-01",
      "name": "后台账号登录全流程",
      "type": "happy",
      "steps": [
        "初始化种子数据（建库 + 种子）",
        "后台账号密码登录（admin/123456 换取 token）",
        "恢复与退出登录态（GET /api/auth/me 返回 admin 用户信息）",
        "恢复与退出登录态（POST /api/auth/logout 作废 token）",
        "恢复与退出登录态（logout 后再调 me 返回 401）"
      ]
    },
    {
      "id": "PATH-02",
      "name": "前台选角色登录全流程",
      "type": "happy",
      "steps": [
        "初始化种子数据（建库 + 种子）",
        "前台选角色快速登录（erpRole=purchase）",
        "恢复与退出登录态（me 返回 role=user 且 erpRole=purchase）",
        "恢复与退出登录态（logout）"
      ]
    },
    {
      "id": "PATH-03",
      "name": "登录异常流",
      "type": "error",
      "steps": [
        "后台账号密码登录（密码错误 → 401 统一文案「账号或密码错误」）",
        "后台账号密码登录（缺 username/password → 400「请输入账号和密码」）",
        "前台选角色快速登录（erpRole 非法枚举 → 400「erpRole 参数不合法」）",
        "后台账号密码登录（user 演示账号走 login → 403「请使用选角色登录」）"
      ]
    },
    {
      "id": "PATH-04",
      "name": "种子重置恢复初始态",
      "type": "happy",
      "steps": [
        "后台账号密码登录（admin）",
        "重置系统恢复种子初始态（reset 返回 categories=12/tutorials=24/users=8/messages=3/checkins=5）",
        "重置系统恢复种子初始态（重复执行第二遍各表数量不增加）",
        "恢复与退出登录态（reset 后旧 token 401，重新登录可用）"
      ]
    },
    {
      "id": "PATH-05",
      "name": "重置权限边界",
      "type": "error",
      "steps": [
        "前台选角色快速登录（user 角色）",
        "重置系统恢复种子初始态（user 调 reset → 403「无权限执行该操作」）",
        "重置系统恢复种子初始态（未携带 token → 401「未登录或登录已失效」）"
      ]
    },
    {
      "id": "PATH-06",
      "name": "空库首次启动建种幂等",
      "type": "edge",
      "steps": [
        "搭建前后端工程脚手架（空库状态下启动 server）",
        "初始化种子数据（建库 + 种子）（自动执行 9 表 DDL 并写入种子）",
        "初始化种子数据（建库 + 种子）（seed:check 断言 12/24/8/3/5 与四态分布 18/3/2/1）",
        "初始化种子数据（建库 + 种子）（重启服务各表数量不变，不产生脏数据）"
      ]
    },
    {
      "id": "PATH-07",
      "name": "三入口脚手架与测试基建可达",
      "type": "edge",
      "steps": [
        "搭建前后端工程脚手架（web dev 启动 5173）",
        "搭建前后端工程脚手架（portal/admin/m 三入口各自返回 200）",
        "搭建验收测试基建（proxy 将 /api 转发 3000，返回统一 JSON 结构而非 Vite 404 HTML）",
        "搭建验收测试基建（playwright 冒烟用例全绿并生成 HTML 报告）"
      ]
    }
  ],
